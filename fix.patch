+/// if c == nil || c2 == nil { return false }
+/// ```
+pub fn equals(c: Option<&Color>, c2: Option<&Color>) -> bool {
+    match (c, c2) {
+        (None, None) => true,
+        (Some(a), Some(b)) => a.equals(b),
+        _ => false,
+    }
+}
+
