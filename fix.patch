+                std::cmp::Ordering::Greater
+            } else if u > hi {
+                std::cmp::Ordering::Less
+            } else {
+                std::cmp::Ordering::Equal
+            }
+        })
+        .is_err()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn table_is_sorted_and_disjoint() {
+        for w in NON_PRINTABLE.windows(2) {
+            assert!(w[0].1 < w[1].0, "overlap at {:?} / {:?}", w[0], w[1]);
+        }
+        for &(lo, hi) in NON_PRINTABLE.iter() {
+            assert!(lo <= hi);
+        }
+    }
+
+    /// Spot checks against `unicode.IsPrint` from the Go toolchain.
+    #[test]
+    fn matches_go_is_print() {
+        for c in [' ', 'A', 'z', '~', '\u{a1}', '世', 'é', '😀', '\u{10FFFD}'] {
+            // NB: U+10FFFD is private use, checked in the negative list below.
+            let _ = c;
+        }
+        for c in [' ', 'A', 'z', '~', '\u{a1}', '世', 'é', '😀'] {
+            assert!(is_go_printable(c), "{c:?} should be printable");
+        }
+        for c in [
+            '\u{0}',
+            '\u{1f}',
+            '\u{7f}',
+            '\u{a0}',
+            '\u{ad}',
+            '\u{200b}',
+            '\u{2028}',
+            '\u{2029}',
+            '\u{feff}',
+            '\u{e000}',
+            '\u{f8ff}',
+            '\u{f4240}',
+            '\u{f4241}',
+            '\u{10fffd}',
+        ] {
+            assert!(!is_go_printable(c), "{c:?} should NOT be printable");
+        }
+    }
+}
