+name: build
+on:
+  push:
+    branches:
+      - main
+  pull_request:
+
+jobs:
+  test:
+    name: Test & Build
+    runs-on: ${{ matrix.os }}
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, macos-latest, windows-latest]
+    steps:
+      - name: Check out code
+        uses: actions/checkout@v4
+
+      - name: Set up Rust
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          components: rustfmt, clippy
+
+      - name: Format
+        run: cargo fmt --all -- --check
+
+      - name: Lint
+        run: cargo clippy --all-targets -- -D warnings
+
+      - name: Test
+        run: cargo test --all-targets
+
+      - name: Doc tests
+        run: cargo test --doc
+
+  # Regenerates the golden files from the original Go package and fails if the
+  # Rust port has drifted from it.
+  parity:
+    name: Go parity
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out code
+        uses: actions/checkout@v4
+
+      - name: Set up Go
+        uses: actions/setup-go@v5
+        with:
+          go-version: stable
+
+      - name: Set up Rust
+        uses: dtolnay/rust-toolchain@stable
+
+      - name: Regenerate golden files from the Go implementation
+        run: |
+          set -e
+          (cd tools/gofmt_golden && go run . > ../../tests/testdata/gofmt_golden.tsv)
+          (cd tools/color_golden && go run . > ../../tests/testdata/color_golden.tsv)
+
+      - name: Verify byte-for-byte parity with Go
+        run: cargo test --test gofmt_parity --test color_parity
